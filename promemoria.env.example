# Copia questo file come "promemoria.env" e compila i valori (il file è escluso da Git).

# --- Fornitore WhatsApp -----------------------------------------------------
# vuoto  = invio manuale dal Pannello Admin ("Apri WhatsApp"), lo script giornaliero fa solo una prova
# meta   = WhatsApp Cloud API (Meta)
# twilio = Twilio
WHATSAPP_PROVIDER=

# --- Dati online (app pubblicata su Render) ----------------------------------
# Con token e repository impostati, script e app locale leggono e scrivono le prenotazioni online.
GITHUB_TOKEN=
GITHUB_REPO=TUO-UTENTE/barber-dati
GITHUB_BRANCH=main

# --- WhatsApp Cloud API (Meta) -----------------------------------------------
# Template da approvare in WhatsApp Manager (nome qui sotto, lingua "it", categoria "Utilità")
# con lo stesso testo del promemoria e {{1}} al posto dell'ora, ad esempio:
#   ...ti ricordiamo il tuo appuntamento presso Stefano Stella Barber Shop per domani alle ore {{1}}...
META_TOKEN=
META_PHONE_NUMBER_ID=
META_TEMPLATE=promemoria_appuntamento
META_TEMPLATE_LANG=it
META_TEMPLATE_PARAMS=ora
META_API_VERSION=v21.0

# --- Twilio (alternativa) ----------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_CONTENT_SID=
