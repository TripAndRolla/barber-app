# Copia questo file come "promemoria.env" e compila i valori.
# Lascia WHATSAPP_PROVIDER vuoto per la modalità prova (nessun messaggio inviato).

WHATSAPP_PROVIDER=meta

# Link per modificare/annullare la prenotazione (solo se il sito è raggiungibile da internet)
PUBLIC_URL=

# App pubblicata su Render: leggi le prenotazioni dal repository dati (stessi valori di Render)
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=main

# --- WhatsApp Cloud API (Meta) -------------------------------------------
# Template da approvare in WhatsApp Manager, lingua "it", categoria "Utilità", testo ad esempio:
#   Ciao {{1}}! Ti ricordiamo l'appuntamento di domani, {{2}}, alle {{3}} ({{4}}).
#   Codice prenotazione: {{5}}. A domani!
META_TOKEN=
META_PHONE_NUMBER_ID=
META_TEMPLATE=promemoria_appuntamento
META_TEMPLATE_LANG=it
META_API_VERSION=v21.0

# --- Twilio (alternativa) ------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_CONTENT_SID=
